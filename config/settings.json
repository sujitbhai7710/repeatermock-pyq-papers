{
  "version": 1,
  "description": "Runtime settings for the SSC PYQ agent. Values here are defaults; environment variables override (see agent/config.py).",
  "year_range": {
    "min": 2019,
    "max": 2025
  },
  "work_window_seconds": 19800,
  "checkpoint_interval_seconds": 1800,
  "rate_limit": {
    "consecutive_failure_threshold": 10,
    "halt_on_any_rate_limit_signal": true,
    "request_timeout_seconds": 120,
    "max_retries_per_request": 1,
    "provider_cooldown_seconds": 300,
    "provider_cooldown_max_seconds": 3600
  },
  "debate": {
    "max_rounds": 1,
    "proposer_model": "deepseek-v4-flash",
    "critic_model": "gpt-5.6-sol",
    "proposer_provider_order": ["agentrouter", "jw"],
    "critic_provider_order": ["agentrouter", "jw"]
  },
  "verify": {
    "batch_size": 20,
    "enabled": true,
    "require_keys": true,
    "max_items_per_run": 0
  },
  "hindi": {
    "regex": "[\\u0900-\\u097F]",
    "scope": ["question", "options"],
    "include_solution": false,
    "exclude_punctuation": false
  },
  "signature": {
    "min_agreement": 0.95,
    "min_section_agreement": 0.95,
    "allow_detected_layout_fallback": true
  },
  "vocab": {
    "min_count_for_md": 1,
    "top_n_per_file": 0
  },
  "paths": {
    "papers_root": ".",
    "state_dir": "state",
    "database_dir": "database",
    "report_dir": "reports"
  }
}
