{
  "version": 1,
  "description": "Runtime settings for the SSC PYQ agent. Values here are defaults; environment variables override (see agent/config.py).",
  "year_range": {
    "min": 2019,
    "max": 2025
  },
  "work_window_seconds": 19800,
  "checkpoint_interval_seconds": 900,
  "rate_limit": {
    "consecutive_failure_threshold": 6,
    "halt_on_any_rate_limit_signal": false,
    "request_timeout_seconds": 120,
    "max_retries_per_request": 1,
    "provider_cooldown_seconds": 300,
    "provider_cooldown_max_seconds": 3600,
    "provider_error_strike_limit": 3
  },
  "debate": {
    "max_rounds": 1,
    "_comment": "proposer_model is the FIRST opinion the verification pass asks for, critic_model the independent judge. Groq (openai/gpt-oss-120b) is the fastest verified route, so it leads the proposer and is the first fallback model for the critic; the judge stays a different model (gpt-5.6-sol) so verification keeps its cross-model check.",
    "proposer_model": "openai/gpt-oss-120b",
    "critic_model": "gpt-5.6-sol",
    "proposer_models": [
      "openai/gpt-oss-120b",
      "deepseek-v4-flash",
      "gpt-5.6-sol"
    ],
    "critic_models": [
      "openai/gpt-oss-120b",
      "gpt-5.6-sol",
      "deepseek-v4-flash"
    ],
    "provider_order": [
      "groq",
      "justwoker",
      "jw-worker",
      "ar-worker",
      "zen-rotator",
      "agentrouter"
    ],
    "proposer_provider_order": [
      "groq",
      "justwoker",
      "jw-worker",
      "ar-worker",
      "zen-rotator",
      "agentrouter"
    ],
    "critic_provider_order": [
      "groq",
      "justwoker",
      "jw-worker",
      "ar-worker",
      "zen-rotator",
      "agentrouter"
    ],
    "model_provider_orders": {
      "_comment": "Per-model provider order, verified live 2026-09-12: openai/gpt-oss-120b is served by groq only; deepseek-v4-flash is only served by ar-worker (justwoker returns 403, jw-worker 503 all_keys_exhausted); gpt-5.6-sol is served by jw-worker and justwoker (ar-worker returns 503). Pinning a model to the routes that actually serve it keeps a request from burning failed attempts on the others, which would otherwise trip the consecutive-failure breaker and halt the model.",
      "openai/gpt-oss-120b": [
        "groq"
      ],
      "deepseek-v4-flash": [
        "ar-worker",
        "justwoker",
        "jw-worker",
        "zen-rotator",
        "agentrouter"
      ],
      "gpt-5.6-sol": [
        "jw-worker",
        "justwoker",
        "ar-worker",
        "zen-rotator",
        "agentrouter"
      ]
    }
  },
  "providers": {
    "order": [
      "groq",
      "justwoker",
      "jw-worker",
      "ar-worker",
      "zen-rotator",
      "agentrouter"
    ],
    "routes": {
      "agentrouter": {
        "label": "agentrouter.org (direct)",
        "base_url": "https://agentrouter.org/v1",
        "auth_style": "bearer",
        "user_agent": "cline/2.0.0",
        "env_keys": [
          "AGENTROUTER_KEYS",
          "OPENAI_KEYS"
        ]
      },
      "ar-worker": {
        "label": "ar-rotator worker",
        "base_url": "https://ar-rotator.opencode-5a3.workers.dev/v1",
        "auth_style": "bearer",
        "user_agent": "browser",
        "env_keys": [
          "AR_PROXY_TOKEN"
        ]
      },
      "groq": {
        "label": "Groq (openai/gpt-oss-120b, fast)",
        "_comment": "Cloudflare fronts api.groq.com and answers 403 'error code: 1010' to clients without a browser User-Agent, so user_agent MUST stay 'browser'.",
        "base_url": "https://api.groq.com/openai/v1",
        "auth_style": "bearer",
        "user_agent": "browser",
        "env_keys": [
          "GROQ_API_KEY"
        ]
      },
      "jw-worker": {
        "label": "jw-rotator worker",
        "base_url": "https://jw-rotator.opencode-5a3.workers.dev/v1",
        "auth_style": "bearer",
        "user_agent": "browser",
        "env_keys": [
          "JW_PROXY_TOKEN"
        ]
      },
      "justwoker": {
        "label": "api.justwoker.icu (direct, Anthropic Messages API)",
        "base_url": "https://api.justwoker.icu/v1",
        "auth_style": "anthropic",
        "user_agent": "browser",
        "env_keys": [
          "JUSTWOKER_KEYS",
          "DEEPSEEK_KEYS"
        ],
        "path": "/messages"
      },
      "zen-rotator": {
        "label": "zen-rotator (Muse free)",
        "base_url": "https://zen-rotator.opencode-5a3.workers.dev/v1",
        "auth_style": "bearer",
        "user_agent": "browser",
        "env_keys": [
          "ZEN_PROXY_TOKEN"
        ]
      }
    }
  },
  "verify": {
    "batch_size": 20,
    "enabled": true,
    "require_keys": true,
    "max_items_per_run": 0
  },
  "hindi": {
    "regex": "[\\u0900-\\u097F]",
    "scope": [
      "question",
      "options"
    ],
    "include_solution": false,
    "exclude_punctuation": false
  },
  "signature": {
    "min_agreement": 0.95,
    "min_section_agreement": 0.95,
    "allow_detected_layout_fallback": true
  },
  "vocab": {
    "min_count_for_md": 1,
    "top_n_per_file": 0
  },
  "paths": {
    "papers_root": ".",
    "state_dir": "state",
    "database_dir": "database",
    "report_dir": "reports"
  },
  "run": {
    "max_work_seconds": 19800,
    "checkpoint_interval_seconds": 900
  }
}
