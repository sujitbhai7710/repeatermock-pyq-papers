# Mark every generated artefact as machine output so it never shows up in
# language stats, diffs or pull-request reviews.  `main` does not track these
# paths at all (see .gitignore); they live on the `pyq-db` checkpoint branch.
state/**          linguist-generated=true linguist-vendored=true -diff
database/**       linguist-generated=true linguist-vendored=true -diff

# The question index shards are large one-line-per-record JSONL files; keeping
# them out of textual diffs avoids a multi-megabyte patch on every checkpoint.
state/index/**    linguist-generated=true linguist-vendored=true -diff -merge
database/mocks/** linguist-generated=true linguist-vendored=true -diff

# Raw corpora stay *source* (not vendored): they are the repository's input.
SSC-*/**          linguist-vendored=false

* text=auto eol=lf
