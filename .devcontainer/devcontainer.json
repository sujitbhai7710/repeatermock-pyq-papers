{
  "name": "SSC PYQ Agent (opencode)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "postCreateCommand": "bash scripts/codespace-setup.sh",
  "postStartCommand": "bash scripts/codespace-setup.sh --quick",
  "postAttachCommand": "bash scripts/codespace-git.sh",
  "secrets": {
    "AGENTROUTER_KEYS": {
      "description": "3 comma-separated agentrouter.org keys (pipeline AI)."
    },
    "JUSTWOKER_KEYS": {
      "description": "3-4 comma-separated api.justwoker.icu keys (pipeline AI)."
    },
    "AR_PROXY_TOKEN": {
      "description": "ar-rotator worker proxy token (deepseek-v4-flash)."
    },
    "JW_PROXY_TOKEN": {
      "description": "jw-rotator worker proxy token (gpt-5.6-sol)."
    },
    "ZEN_PROXY_TOKEN": {
      "description": "zen-rotator worker proxy token (muse-spark-1.2)."
    },
    "MONID_API_KEY": {
      "description": "Monid/TinyFish key for web search + fetch."
    },
    "GROQ_API_KEY": {
      "description": "Groq key — openai/gpt-oss-120b, the fastest verifier."
    }
  },
  "remoteEnv": {
    "PYTHONUNBUFFERED": "1",
    "PYTHONUTF8": "1",
    "PYQ_GIT_PUSH": "1",
    "CHECKPOINT_INTERVAL_SECONDS": "900",
    "MAX_WORK_SECONDS": "12600",
    "OPENAI_BASE_URL": "https://ar-rotator.opencode-5a3.workers.dev/v1",
    "OPENAI_API_KEY": "${localEnv:AR_PROXY_TOKEN}",
    "OPENCODE_MODEL": "deepseek-v4-flash"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
