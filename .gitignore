# ---------------------------------------------------------------------------
# Branch strategy
#
#   main     = code only.  The generated tree is *not* versioned here: it is
#              100+ MB of machine output that changes on every run, so it is
#              ignored and published on the `pyq-db` checkpoint branch instead.
#   pyq-db   = the generated `state/` + `database/` tree.  The workflow copies
#              it there with an explicit `git add -f state database` (the -f is
#              required precisely because of the two rules below).
#
# Raw data (`SSC-*/**/*.json`, `chapter-and-topic/*.md`) is *not* ignored: it is
# the repository's source of truth and stays on every branch.
# ---------------------------------------------------------------------------
/state/
/database/

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# agent scratch files (atomic writes use .tmp-*.part next to the target); the
# checkpoint commit removes leftovers explicitly before `git add -f`
.tmp-*.part

# editor / OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/
